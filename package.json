{
  "name": "astrowed-destiny-lab",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/sync-map-assets.ts",
    "prebuild": "node scripts/sync-map-assets.ts",
    "setup:workspace": "tsx scripts/setup-workspace.ts",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "build:pages": "next build apps/pages",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "verify:pages": "node scripts/verify-pages.ts",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "db:seed": "tsx scripts/seed.ts",
    "db:inspect": "tsx scripts/inspect-db.ts",
    "prebuild:pages": "node scripts/sync-city-assets.ts && node scripts/sync-map-assets.ts"
  },
  "dependencies": {
    "drizzle-orm": "^0.45.3",
    "jose": "^6.2.12",
    "jspdf": "^4.2.1",
    "lunar-typescript": "1.8.6",
    "luxon": "^3.7.2",
    "maplibre-gl": "^6.11.2",
    "motion": "^13.4.4",
    "next": "^16.3.6",
    "pg": "^8.23.0",
    "playwright": "^1.63.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "server-only": "^0.0.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@types/luxon": "^3.7.5",
    "@types/node": "^26.6.2",
    "@types/pg": "^8.23.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "dotenv": "^18.0.3",
    "drizzle-kit": "^0.31.11",
    "prettier": "^3.9.9",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.2"
  },
  "overrides": {
    "@esbuild-kit/core-utils": {
      "esbuild": "^0.25.0"
    }
  }
}
